# =============================================================================
# Minecraft AFK Bot Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub. Only .env.example with fake values is tracked.
# =============================================================================

# --- Connection ---
HOST=play.example.com
PORT=25565
USERNAME=Bot
VERSION=
AUTH=offline

# --- Login ---
PASSWORD=your_password
LOGIN_DELAY_MS=2000

# --- Auto Eat ---
EAT_BELOW_FOOD=14

# --- Rotation ---
ROTATE_INTERVAL_MS=5000

# --- Reconnect ---
RECONNECT_DELAY_MS=5000

# --- Anti-AFK ---
ANTI_AFK_ENABLED=true
ANTI_AFK_SWING_MIN_MS=20000
ANTI_AFK_SWING_MAX_MS=45000
ANTI_AFK_SNEAK=true
ANTI_AFK_SLOT_SWITCH=true
ANTI_AFK_COMMAND=
ANTI_AFK_COMMAND_INTERVAL_MIN=10
LOG_ANTI_AFK=true

# --- TPA (outgoing) ---
TPA_PLAYER=
TPA_DELAY_MS=5000
TPA_RETRY=false
TPA_RETRY_INTERVAL_SEC=60
TPA_MAX_RETRIES=3

# --- TPA (auto-accept) ---
TPA_ACCEPT_ENABLED=false
TPA_ACCEPT_WHITELIST=Steve,Alex
TPA_ACCEPT_MAX_PER_HOUR=10
TPA_PATTERNS_FILE=./tpa-patterns.json
TPA_DEBUG_CHAT=false
